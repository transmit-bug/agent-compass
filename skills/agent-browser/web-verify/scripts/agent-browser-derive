#!/usr/bin/env python3
"""agent-browser-derive — deterministic derivation for the agent-browser suite.

One script, one job: derive. The AGENT writes the records
(`.agent-browser/index.json`, schema in references/session-model.md) with
Write/Edit as it works — there is no run-lifecycle ceremony here. This script
only scaffolds the state home (`init`), renders the orient doc + derived status
from records (`render`), and computes staleness / retention facts (`stale`,
`tidy`). It computes and stores; it never decides. Judgment stays with the
agent; the CLI (`agent-browser`) is the reference for the browser surface.

Contract: references/session-model.md (owned by web-verify).
"""
import argparse
import datetime
import fnmatch
import json
import os
import re
import shutil
import subprocess
import sys

BASE = ".agent-browser"
RUNS = os.path.join(BASE, "runs")
INDEX_JSON = os.path.join(BASE, "index.json")
INDEX_MD = os.path.join(BASE, "index.md")

VERDICTS = ("pass", "fail", "unsure")

# Derived-status precedence, worst first (ADR-0002 vocabulary): blocked (work cannot
# proceed), failing (known wrong), stale (untrusted), in-progress (being worked),
# verified. Sorting shares this order.
STATUS_ORDER = ["blocked", "failing", "stale", "in-progress", "verified"]

# Per-feature stage, from the latest run's skill.
STAGE_BY_SKILL = {
    "web-dev": "dev",
    "web-checker": "check",
    "web-fixer": "fix",
    "web-smoke": "smoke",
    "web-maintain": "maintain",
    "web-logic": "logic",
}

ASSESSMENT_KINDS = {
    "completeness": ["complete", "partial", "missing"],
    "logic": ["clear", "ambiguous", "contradictory"],
    "flow": ["sound", "awkward", "broken"],
    "ui": ["reasonable", "ineffective", "broken"],
}

CONCERN_KINDS = {"missing", "contradictory", "broken"}

DEFAULTS = {
    "uiSurface": ["src/**", "components/**", "pages/**", "app/**", "*.tsx", "*.jsx", "*.vue", "*.css", "*.scss"],
    "uiKeywords": ["feat", "fix", "redesign", "ui", "style", "layout", "component", "visual"],
    "uiDeps": ["react", "next", "vue", "svelte", "angular", "antd", "tailwind", "chakra", "mantine"],
    "thresholds": {"maxAttempts": 3, "staleSinceDays": 30, "keepRuns": 5, "commitHorizon": 50},
}


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def git(args, cwd=None):
    return subprocess.run(["git"] + args, capture_output=True, text=True, cwd=cwd)


def load_json(path, default):
    if os.path.exists(path):
        with open(path) as f:
            return json.load(f)
    return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")


def save_md(path, lines):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "w") as f:
        f.write("\n".join(lines))


def load_index():
    return load_json(INDEX_JSON, {"runs": [], "assessments": []})


def save_index(index):
    save_json(INDEX_JSON, index)


def run_verdict(run):
    """Aggregate a run's checkpoints: any fail → fail; else any unsure → unsure; else pass."""
    v = [c.get("verdict") for c in run.get("checkpoints", [])]
    if any(x == "fail" for x in v):
        return "fail"
    if any(x == "unsure" for x in v):
        return "unsure"
    return "pass" if v else "-"


def derive_status(run):
    """Derive the per-flow status from ONE record (ADR-0002)."""
    if run.get("blockers"):
        return "blocked"
    if run.get("status") == "failed":
        return "failing"  # run terminated as failed — known-broken, not "resume me"
    if run.get("status") in ("running", "aborted"):
        return "in-progress"
    verdict = run_verdict(run)
    if verdict == "fail":
        return "failing"
    if run.get("stale"):
        return "stale"
    if verdict == "unsure":
        return "in-progress"
    if verdict == "pass":
        return "verified"
    return "in-progress"


def status_rank(status):
    return STATUS_ORDER.index(status) if status in STATUS_ORDER else len(STATUS_ORDER)


def latest_run_per_flow(runs):
    latest = {}
    for r in sorted(runs, key=lambda r: r.get("startedAt", ""), reverse=True):
        latest.setdefault((r["app"], r["slug"]), r)
    return latest


def latest_assessments(assessments):
    latest = {}
    for a in sorted(assessments, key=lambda a: a.get("assessedAt", ""), reverse=True):
        latest.setdefault((a["app"], a["scope"]), a)
    return latest


def assessment_concerns(assessment):
    return [kind for kind in ASSESSMENT_KINDS if assessment.get(kind) in CONCERN_KINDS]


def next_actions(runs, assessments):
    actions = []
    for key, r in sorted(latest_run_per_flow(runs).items(),
                         key=lambda kv: (status_rank(derive_status(kv[1])),
                                         kv[1].get("startedAt", ""))):
        flow = key[1]
        st = derive_status(r)
        if st == "in-progress":
            actions.append(f"resume {flow} from its checkpoints")
        elif st == "blocked":
            actions.append(f"resolve blocker(s) {', '.join(r['blockers'])} on {flow}")
        elif st == "stale":
            actions.append(f"re-verify {flow} before trusting it (via {r.get('skill','-')})")
        elif st == "failing":
            actions.append(f"check/fix {flow} (last run failed)")
    for key, a in sorted(latest_assessments(assessments).items()):
        concerns = assessment_concerns(a)
        if concerns:
            actions.append(f"review {key[1]}: {', '.join(concerns)}")
    refs = sorted({r.get("ticket") for r in runs if r.get("ticket")}
                  | {b for r in runs for b in (r.get("blockers") or [])})
    return actions, refs


def expectations_list():
    d = os.path.join(BASE, "expectations")
    if os.path.isdir(d):
        return sorted(f for f in os.listdir(d) if f.endswith(".md"))
    return []


def scenarios_list():
    d = os.path.join("docs", "agent-browser", "scenarios")
    if not os.path.isdir(d):
        return []
    out = []
    for base, _dirs, files in os.walk(d):
        for f in sorted(files):
            if f.endswith(".md"):
                out.append(os.path.relpath(os.path.join(base, f), d))
    return sorted(out)


def durable_docs():
    """docs/agent-browser/ files outside the scenario library (it has its own section)."""
    d = os.path.join("docs", "agent-browser")
    if not os.path.isdir(d):
        return []
    out = []
    for base, _dirs, files in os.walk(d):
        for f in sorted(files):
            if f.endswith(".md"):
                p = os.path.relpath(os.path.join(base, f), "docs")
                if p.startswith("agent-browser/scenarios/"):
                    continue
                out.append(p)
    return sorted(out)


def truncate(s, n=120):
    s = s.replace("|", "\\|")
    return s if len(s) <= n else s[: n - 1] + "…"


def render_orient(index):
    runs = index.get("runs", [])
    assessments = index.get("assessments", [])
    lines = ["# Web-App Lifecycle · orient doc (derived — do not edit)", ""]

    latest = latest_run_per_flow(runs)
    if latest:
        lines.append("## Status (derived)")
        lines.append("| flow | stage | status | last verified | verdict | notes |")
        lines.append("|---|---|---|---|---|---|")
        la = latest_assessments(assessments)
        for key, r in sorted(latest.items(),
                             key=lambda kv: (status_rank(derive_status(kv[1])),
                                             kv[1].get("startedAt", ""))):
            flow = key[1]
            stamp = (r.get("finishedAt") or r.get("startedAt") or "-")[:16]
            stage = STAGE_BY_SKILL.get(r.get("skill", ""), "-")
            notes = []
            if r.get("blockers"):
                notes.append("blocked: " + ", ".join(r["blockers"]))
            if r.get("ticket"):
                notes.append("ticket " + r["ticket"])
            a = la.get((r["app"], flow))
            if a:
                concerns = assessment_concerns(a)
                if concerns:
                    notes.append("assess: " + ", ".join(concerns))
            lines.append(f"| {flow} | {stage} | {derive_status(r)} | {stamp} | "
                         f"{run_verdict(r)} | {'; '.join(notes) or '-'} |")
        lines.append("")

    la = latest_assessments(assessments)
    if la:
        lines.append("## Assessments (latest per scope)")
        lines.append("| scope | completeness | logic | flow | ui | gist |")
        lines.append("|---|---|---|---|---|---|")
        for key, a in sorted(la.items()):
            lines.append(f"| {key[1]} | {a.get('completeness','-')} | {a.get('logic','-')} "
                         f"| {a.get('flow','-')} | {a.get('ui','-')} | {truncate(a.get('gist','-'))} |")
        lines.append("")

    actions, refs = next_actions(runs, assessments)
    if actions or refs:
        lines.append("## Next actions (derived)")
        for a in actions:
            lines.append(f"- {a}")
        if refs:
            lines.append(f"- tracker: check open refs {', '.join(refs)}")
        lines.append("")

    exps = expectations_list()
    if exps:
        lines.append("## Expectations (reusable ground truth)")
        for e in exps:
            lines.append(f"- {e}")
        lines.append("")

    scens = scenarios_list()
    if scens:
        lines.append("## Scenarios (the plan/recipe library)")
        for s in scens:
            lines.append(f"- {s}")
        lines.append("")

    docs = durable_docs()
    if docs:
        lines.append("## Durable docs")
        for d in docs:
            lines.append(f"- [docs/{d}](docs/{d})")
        lines.append("")

    if not runs and not assessments:
        lines.append("(no records yet — the orient doc fills with the first run)")
        lines.append("")

    if runs:
        lines.append("## Recent runs")
        lines.append("| time | flow | skill | commit | verdict | status |")
        lines.append("|---|---|---|---|---|---|")
        for r in sorted(runs, key=lambda r: r.get("startedAt", ""), reverse=True)[:20]:
            stamp = r.get("finishedAt") or r.get("startedAt") or "-"
            lines.append(f"| {stamp[:16]} | {r['slug']} | {r.get('skill','-')} "
                         f"| {r.get('commit','-')[:8]} | {run_verdict(r)} | {r.get('status','')} |")
    save_md(INDEX_MD, lines)


def validate_records(index):
    """Schema drift warnings — the agent writes records by hand; flag shape slips."""
    warns = []
    for r in index.get("runs", []):
        for c in r.get("checkpoints", []):
            if c.get("verdict") not in VERDICTS:
                warns.append(f"run {r.get('id','?')}: checkpoint '{c.get('step')}' "
                             f"verdict {c.get('verdict')!r} not in {VERDICTS}")
    return warns


# ---------------------------------------------------------------- commands

def cmd_init(args):
    """Scaffold the app repo's .agent-browser/ state home (idempotent)."""
    index = load_index()
    created = []
    if not os.path.isdir(BASE):
        os.makedirs(BASE, exist_ok=True)
        created.append(BASE)
    if not os.path.exists(INDEX_JSON):
        save_json(INDEX_JSON, {"runs": [], "assessments": []})
        created.append(INDEX_JSON)
    render_orient(index)

    entry = ".agent-browser/runs/"
    header = "# agent-browser evidence (bulky; git stays the archive)"
    gi = ".gitignore"
    if os.path.exists(gi) and entry in open(gi).read().splitlines():
        gi_note = "exists"
    else:
        with open(gi, "a") as f:
            if os.path.exists(gi) and os.path.getsize(gi) > 0:
                f.write("\n")
            f.write(f"{header}\n{entry}\n")
        gi_note = "created" if gi not in created else "appended"
        created.append(gi)
    print(json.dumps({"created": created, "gitignore": gi_note, "orientDoc": INDEX_MD,
                      "note": "next: record how to run the app, then start a run by adding a run record"},
                     ensure_ascii=False))


def cmd_render(args):
    index = load_index()
    render_orient(index)
    warns = validate_records(index)
    out = {"orientDoc": INDEX_MD, "runs": len(index.get("runs", [])),
           "assessments": len(index.get("assessments", []))}
    if warns:
        out["warnings"] = warns
    print(json.dumps(out, ensure_ascii=False, indent=2))


# ---------------------------------------------------------------- staleness

def load_manifest():
    m = load_json(os.path.join(BASE, "manifest.json"), {})
    cfg = {}
    cfg.update(DEFAULTS)
    for k in ("uiSurface", "uiKeywords", "uiDeps"):
        if k in m:
            cfg[k] = m[k]
    t = dict(DEFAULTS["thresholds"])
    t.update(m.get("thresholds", {}))
    cfg["thresholds"] = t
    return cfg


def file_hits(files, patterns):
    hits = []
    for f in files:
        f = f.replace("\\", "/")
        if any(fnmatch.fnmatch(f, p) or fnmatch.fnmatch("/" + f, p) for p in patterns):
            hits.append(f)
    return hits


def deps_bumped(pkg_diff, ui_deps):
    removed = re.findall(r'^-(?:[^"]*")([a-z0-9@\-_./]+)"\s*:\s*"[^"]+"', pkg_diff, re.M)
    added = re.findall(r'^\+(?:[^"]*")([a-z0-9@\-_./]+)"\s*:\s*"[^"]+"', pkg_diff, re.M)
    removed_set = {x.split("/")[0] if x.startswith("@") else x for x in removed}
    added_set = {x.split("/")[0] if x.startswith("@") else x for x in added}
    return [d for d in ui_deps if any((removed_set or added_set) and d in removed_set or d in added_set)]


def eval_run(r, cfg, since_days):
    """Return (stale_obj|None) for one index run."""
    if r.get("status") != "complete" or r.get("supersededBy"):
        return None
    commit = r.get("commit")
    if not commit:
        return None
    commits = git(["log", f"{commit}..HEAD", "--format=%H %s"])
    subjects = commits.stdout.strip().splitlines()
    files = git(["diff", "--name-only", f"{commit}..HEAD"]).stdout.strip().splitlines()
    files = [f for f in files if f]

    ui_files = file_hits(files, cfg["uiSurface"])
    prov_hit = [f for f in files if f in (r.get("provenance") or [])]
    msg_hit = [s for s in subjects if any(kw.lower() in s.lower() for kw in cfg["uiKeywords"])]
    pkg_hit = []
    if "package.json" in files:
        pkg_diff = git(["diff", f"{commit}..HEAD", "--", "package.json"]).stdout
        pkg_hit = deps_bumped(pkg_diff, cfg["uiDeps"])

    strong = ui_files or prov_hit or msg_hit or pkg_hit
    weak = False
    if r.get("finishedAt"):
        try:
            t = datetime.datetime.fromisoformat(r["finishedAt"].replace("Z", "+00:00"))
            age = (datetime.datetime.now(datetime.timezone.utc) - t).days
            weak = age > since_days
        except ValueError:
            weak = False

    if not strong and not weak:
        return None
    return {
        "runId": r["id"], "slug": r["slug"], "app": r["app"], "skill": r.get("skill"),
        "reason": "provenance-change" if prov_hit else ("ui-change" if strong else "age"),
        "severity": "strong" if strong else "weak",
        "detectedAt": now_iso(),
        "commitsSince": len(subjects),
        "uiFiles": ui_files[:10],
        "provFiles": prov_hit[:10],
        "messageHits": msg_hit[:5],
        "depBumps": pkg_hit,
    }


def cmd_stale(args):
    cfg = load_manifest()
    since_days = args.since or cfg["thresholds"]["staleSinceDays"]
    index = load_index()
    results = []
    for r in index["runs"]:
        stale = eval_run(r, cfg, since_days)
        if stale:
            results.append(stale)
        if args.mark:
            r["stale"] = stale  # record the computed fact; forgetting stays with tidy
    out = {"stale": results, "count": len(results)}
    if args.mark:
        save_index(index)
        render_orient(index)
        out["marked"] = "stale facts recorded; orient doc re-rendered"
    print(json.dumps(out, ensure_ascii=False, indent=2))


def cmd_tidy(args):
    cfg = load_manifest()
    t = cfg["thresholds"]
    index = load_json(INDEX_JSON, {"runs": []})
    runs = index["runs"]

    groups = {}
    for r in runs:
        groups.setdefault((r["app"], r["slug"]), []).append(r)
    for g in groups.values():
        g.sort(key=lambda r: r.get("startedAt", ""), reverse=True)

    drop_ids = []
    for (app, slug), g in groups.items():
        for i, r in enumerate(g):
            if r.get("supersededBy") and i >= t["keepRuns"]:
                drop_ids.append(r["id"])
        for r in g:
            if r["id"] in drop_ids:
                continue
            if not r.get("supersededBy"):
                commits = git(["log", f"{r.get('commit')}..HEAD", "--format=%H"]) if r.get("commit") else []
                n = len(commits.stdout.strip().splitlines()) if commits.returncode == 0 else 0
                if n > t["commitHorizon"]:
                    drop_ids.append(r["id"])
        active = [r for r in g if not r.get("supersededBy")]
        if not active:
            continue
        newest = active[0]
        if newest.get("finishedAt"):
            try:
                tm = datetime.datetime.fromisoformat(newest["finishedAt"].replace("Z", "+00:00"))
                age = (datetime.datetime.now(datetime.timezone.utc) - tm).days
                if age > t["staleSinceDays"]:
                    for r in active:
                        drop_ids.append(r["id"])
            except ValueError:
                pass

    drop_ids = list(dict.fromkeys(drop_ids))
    if args.dry_run or not args.apply:
        print(json.dumps({"wouldDrop": drop_ids, "count": len(drop_ids)}, ensure_ascii=False, indent=2))
        return
    keep = [r for r in runs if r["id"] not in drop_ids]
    index["runs"] = keep
    save_index(index)
    render_orient(index)
    removed_evidence = 0
    for r in runs:
        if r["id"] in drop_ids:
            d = os.path.join(RUNS, r["app"], r["slug"])
            if os.path.isdir(d):
                shutil.rmtree(d)
                removed_evidence += 1
    print(json.dumps({"dropped": drop_ids, "count": len(drop_ids),
                      "evidenceDirsRemoved": removed_evidence}, ensure_ascii=False, indent=2))


def main():
    p = argparse.ArgumentParser(description="agent-browser suite — deterministic derivation")
    sub = p.add_subparsers(dest="cmd", required=True)

    i = sub.add_parser("init", help="scaffold .agent-browser/ + .gitignore (idempotent)")
    i.set_defaults(fn=cmd_init)

    r = sub.add_parser("render", help="derive status + orient doc from records (.agent-browser/index.json)")
    r.set_defaults(fn=cmd_render)

    s = sub.add_parser("stale", help="deterministic staleness scan")
    s.add_argument("--since", type=int, default=None)
    s.add_argument("--mark", action="store_true", help="record computed staleness facts on the index")
    s.set_defaults(fn=cmd_stale)

    t = sub.add_parser("tidy", help="retention policy (preview or apply)")
    t.add_argument("--dry-run", action="store_true")
    t.add_argument("--apply", action="store_true")
    t.set_defaults(fn=cmd_tidy)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
